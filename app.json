{
  "expo": {
    "name": "Forma",
    "slug": "forma-fitness",
    "version": "0.1.0",
    "scheme": "forma",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forma.fitness"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Forma usa tus fotos para estimar las calor\u00edas de tus comidas y analizar tu progreso f\u00edsico.",
          "cameraPermission": "Forma usa la c\u00e1mara para fotografiar tus comidas y tu f\u00edsico.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
